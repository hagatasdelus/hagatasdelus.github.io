{
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  },
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.0.4/",
    "date-fns": "npm:date-fns",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "compilerOptions": {
    "types": ["lume/types.ts"],
    "jsx": "react-jsx",
    "jsxImportSource": "npm:@lumeland/ssx"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": ["_site", "_cache", "node_modules"]
  },
  "unstable": ["temporal", "fmt-component"],
  "lint": {
    "plugins": ["https://deno.land/x/lume@v3.0.4/lint.ts"]
  }
}
